# Local environments, secrets, editor settings and caches.
/.env
/.env.*
!/.env.example
/.venv/
/.codex/
/.cache/
/.localrc.sh
/.vscode/
**/__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Downloaded datasets and pretrained models: placeholders only.
/resources/data/*
!/resources/data/.gitkeep
/resources/pretrained_models/*
!/resources/pretrained_models/.gitkeep
/data/*
!/data/.gitkeep
/pretrained_models/*
!/pretrained_models/.gitkeep

# Model weights, checkpoints, serialized data and array artifacts.
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.bin
*.hdf5
*.h5
*.pkl
*.npy
*.npz

# Training, evaluation and generated recordings.
/encoder_results/*
!/encoder_results/.gitkeep
/policy_results/*
!/policy_results/.gitkeep
/policy_logs/
/eval_result/
/dry_eval_result/
/archive/encoder_ablation/
/archive/encoder_logs/
/logs/
/log
/replay/
/traj*
/policy/**/checkpoints/
/policy/**/outputs/
*.log
*.mp4
*.avi
*.mov
/scripts/*.png

# Downloaded/generated simulation assets; retain source scene assets.
/resources/assets/objects/ipt/
/resources/assets/objects/opt/
/resources/assets/objects/BlueBlock*
/resources/assets/objects/GreenBlock*
/resources/assets/objects/OrangeBlock*
/resources/assets/objects/textures/
/resources/assets/objects/.thumbs/
/resources/assets/textures/*
!/resources/assets/textures/Cherry*
!/resources/assets/textures/color_121212.hdr
/resources/assets/embodiments/ARX-X5/

# Extra local third-party checkouts; keep the vendored TacEx sources.
/resources/third_party/*
!/resources/third_party/TacEx/

# Legacy local artifacts.
/policy/ACT_UniT/
/*.ipynb
/*.png
/policy/**/*.png

# GelSight Mini calibration files are required simulation assets.
!/resources/third_party/TacEx/source/tacex_assets/tacex_assets/data/Sensors/GelSight_Mini/**/*.pth
!/resources/third_party/TacEx/source/tacex_assets/tacex_assets/data/Sensors/GelSight_Mini/**/*.npy
!/resources/third_party/TacEx/source/tacex_assets/tacex_assets/data/Sensors/GelSight_Mini/**/*.npz
